<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishTrimmed>false</PublishTrimmed>
    <CompressionEnabled>false</CompressionEnabled>
    <RunAOTCompilation>false</RunAOTCompilation>
    <WasmBuildNative>false</WasmBuildNative>
    <BlazorEnableTimeZoneSupport>false</BlazorEnableTimeZoneSupport>
  </PropertyGroup>
  <Import Project="../Kni.props" />
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
    <ProjectReference Include="../Platform/Platform.csproj" />
    <Content Include="../../original/Content/**/*.xnb" Link="wwwroot/Content/%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../.port-cache/content/manifest.json" Link="wwwroot/Content/manifest.json" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="VerifyOriginalContent" BeforeTargets="PrepareForBuild">
    <Exec Command="python3 &quot;$(MSBuildProjectDirectory)/../../tools/build_content.py&quot;" />
  </Target>
</Project>
